# Copy your original .env for an existing installation. Do not publish secrets.
PORT=5000
FRONTEND_URL=https://localhost:5173,https://127.0.0.1:5173,http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pose_and_pics
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=5
DB_LOGGING=false
JWT_SECRET=REPLACE_WITH_YOUR_PRIVATE_RANDOM_SECRET
JWT_EXPIRES_IN=7d
AUTO_COMPLETE_SESSIONS=false

# Optional real email recovery: configure a verified Brevo sender and trusted HTTPS URL.
STUDIO_TIME_ZONE=Asia/Manila
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
PASSWORD_RESET_BASE_URL=
